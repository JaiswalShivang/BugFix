FROM node:20-slim
WORKDIR /app/apps/demo-ecommerce
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
COPY apps/demo-ecommerce/package.json ./
RUN npm install
COPY apps/demo-ecommerce ./
EXPOSE 3000
HEALTHCHECK --interval=3s --timeout=3s --start-period=5s --retries=15 \
  CMD curl -f http://127.0.0.1:3000/checkout || exit 1
CMD ["npx", "next", "dev", "-p", "3000"]
