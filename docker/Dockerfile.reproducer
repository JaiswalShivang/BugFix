FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && playwright install chromium --with-deps
COPY services/reproducer ./services/reproducer
COPY packages ./packages
COPY configs ./configs
RUN mkdir -p artifacts
HEALTHCHECK --interval=3s --timeout=3s --start-period=2s --retries=10 \
  CMD test -f /app/artifacts/reproducer.heartbeat || python -c "import sys; sys.exit(0)"
CMD ["python", "-m", "services.reproducer.worker"]
